# syntax=docker/dockerfile:1
FROM python:3.11-slim

WORKDIR /app

# 이 VM엔 GPU가 없는데, index 지정 없이 pip install torch를 하면 Linux에서는 안 쓰는
# CUDA 라이브러리(nvidia-cublas 등)까지 딸려와 수 GB가 낭비된다 — sentence-transformers가
# 요구하는 torch를 CPU 전용 wheel로 먼저 설치해서 그 버전을 그대로 재사용하게 한다.
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu

COPY requirements-api.txt ./
RUN pip install --no-cache-dir -r requirements-api.txt

# 컨테이너 재기동/재배포 때마다 다시 받지 않도록 임베딩 모델을 빌드 타임에 미리 캐시해둔다.
RUN python -c "from sentence_transformers import SentenceTransformer; SentenceTransformer('nlpai-lab/KURE-v1')"

# backend/app/rag/ingest.py, backend/app/graph/nodes/rules.py가 각각
# 저장소 루트 기준 상대경로(data/knowledge_base, backend/rules.yaml)로 파일을 찾으므로
# 실제 저장소 레이아웃을 그대로 유지한다(backend/, data/knowledge_base 형제 디렉터리 구조).
COPY backend/ backend/
COPY data/knowledge_base/ data/knowledge_base/

WORKDIR /app/backend

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
