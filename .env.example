# 채팅 LLM: 업스테이지 Solar. 기본 모델 호출 실패 시 FALLBACK 모델로 자동 롤백된다.
UPSTAGE_API_KEY=
LLM_MODEL_PRIMARY=solar-pro3
LLM_MODEL_FALLBACK=solar-pro2

# 임베딩은 한국어 특화 오픈소스 모델을 로컬에서 자체 호스팅한다 (RAG 벡터 검색용). API 키 불필요.
EMBEDDING_MODEL=nlpai-lab/KURE-v1

RAG_TOP_K=1

# 5-1절: AI Hub 공개 데이터 API
AI_HUB_API_KEY=

# data.go.kr(공공데이터포털) 파일데이터 Open API 인증키. 마이페이지 > 활용신청 현황에서
# 발급받은 "일반 인증키(Decoding)"를 그대로 넣는다(요청 시 자동으로 URL 인코딩됨).
DATA_GO_KR_API_KEY=***REMOVED_DATA_GO_KR_API_KEY***

# Supabase (PostgreSQL). Connect 메뉴에서 Direct connection이 IPv6라 안 붙으면
# Transaction/Session pooler 연결 문자열을 사용한다.
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_DATABASE_URL=

# Langfuse 트레이싱. 키는 Langfuse 프로젝트 Settings > API Keys에서 발급.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# 개발 중 생긴 트레이스가 나중에 운영 데이터와 섞이지 않도록 환경을 구분한다.
LANGFUSE_TRACING_ENVIRONMENT=development